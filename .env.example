# Narra 环境变量示例
#
# 用法：复制为仓库根目录的 .env（本地开发；应用启动时会自动加载）。
# 线上部署：不要把 .env 放进代码目录或镜像，由 Docker Compose / 进程管理器注入环境变量。
# 注意：环境变量优先级高于 configs/config.yaml；下面列出的才是应用真正读取的变量。

# —— 密码与密钥 ——

# PostgreSQL 密码（主机 / 端口 / 用户名 / 库名仍在 configs/config.yaml）
POSTGRES_PASSWORD=

# Redis 密码（其余连接信息在 configs/config.yaml）
REDIS_PASSWORD=

# JWT 签名密钥。⚠️ 它同时被用作数据库内 API Key 的加密密钥：
# 上线请改成 32 位以上随机串，且之后不要随意更换，否则已保存的密钥将无法解密。
JWT_SECRET=

# 阿里云短信（开通短信服务并审核签名、模板后启用）
SMS_ENABLED=false
SMS_REGION_ID=cn-hangzhou
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# OpenAI 兼容 Embedding 配置（仅用于首次启动的默认密钥；页面保存后会加密存入数据库）
# 配置加载器不会自动读取 .env 文件，请由 Shell、Docker Compose 或进程管理器导出。
# OpenAI 兼容 Embedding 密钥（仅作首次启动默认值；设置页保存后会加密存入数据库）
EMBEDDING_API_KEY=

# 语音合成（阿里云百炼）API Key
TTS_API_KEY=

# 文档解析 OCR API 密钥（仅 document_parser.ocr_engine=api 时需要；默认走本地 OCR，不外发文档内容）
DOCUMENT_PARSER_OCR_API_KEY=

# 外部搜索 MCP 服务密钥（变量名需与 MCP 配置里的 auth_env 一致才会被引用）
MCP_SEARCH_API_KEY=

# Langfuse 可观测（langfuse.enabled=true 时需要）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 阿里云 OSS 凭证（storage.oss.enabled=true 时需要）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 说明：APP_* / LOG_* / POSTGRES_HOST 等变量当前不会被应用读取，请直接改 configs/config.yaml。
