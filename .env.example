# Narra 环境变量示例
#
# 用法：复制为仓库根目录的 .env（本地开发；应用启动时会自动加载，向上最多找 8 层目录）。
# 线上部署：不要把 .env 放进代码目录或镜像，由 Docker Compose / 进程管理器注入环境变量。
# 注意：环境变量优先级高于 configs/config.yaml；空值视为"未设置"，不会覆盖。
# 下面列出的才是应用真正读取的变量。

# —— 数据库与运行参数 ——

# PostgreSQL（容器部署时 host 常改为服务名，如 postgres）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=narra
# 云数据库（RDS 等）强制 TLS 时配 require / verify-full；留空 = disable
POSTGRES_SSLMODE=

# Redis（生成任务队列 asynq 的硬依赖，必须可用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 运行模式与日志级别（mode 只能是 debug / release / test）
APP_MODE=debug
APP_PORT=8080
LOG_LEVEL=debug

# —— 密钥 ——

# JWT 签名密钥。⚠️ 它同时被用作数据库内 API Key 的加密密钥：
# 上线请改成 32 位以上随机串，且之后不要随意更换，否则已保存的密钥将无法解密。
JWT_SECRET=

# OpenAI 兼容 Embedding 密钥（仅作首次启动默认值；设置页保存后会加密存入数据库）
EMBEDDING_API_KEY=

# 语音合成（阿里云百炼）API Key
TTS_API_KEY=

# 文档解析 OCR API 密钥（仅 document_parser.ocr_engine=api 时需要；默认走本地 OCR，不外发文档内容）
DOCUMENT_PARSER_OCR_API_KEY=

# 外部搜索 MCP 服务密钥（变量名需与 MCP 配置里的 auth_env 一致才会被引用）
MCP_SEARCH_API_KEY=

# Langfuse 可观测（langfuse.enabled=true 时需要）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 阿里云 OSS 凭证（配合 configs/config.yaml 的 storage.oss：四项填齐走 OSS，全部留空走本地兜底）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 说明：APP_NAME / APP_VERSION / LOG_FILENAME / LOG_MAX_SIZE 等仍不读环境变量，请改 configs/config.yaml。
